<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <ImageButton
        android:id="@+id/buttonBack"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="-8dp"
        android:layout_marginTop="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="返回"
        android:src="@drawable/ic_back_arrow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textViewTimerTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="组间休息"
        android:textColor="?attr/bcPrimary"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 大数字计时器：单行显示，避免换行 -->
    <TextView
        android:id="@+id/textViewTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:gravity="center"
        android:maxLines="1"
        android:singleLine="true"
        android:text="01:30"
        android:textColor="?attr/bcPrimary"
        android:textSize="88sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textViewTimerTitle" />

    <!-- 开始 / 重置：放大 -->
    <LinearLayout
        android:id="@+id/layoutTimerButtons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textViewTimer">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonStartTimer"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginEnd="16dp"
            android:layout_weight="1"
            android:text="开始"
            android:textSize="20sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonResetTimer"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:text="重置"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- 后台运行提示：计时中才显示（用 invisible 占位，避免切换时布局跳动） -->
    <TextView
        android:id="@+id/textViewTimerHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="计时在后台继续，可下拉通知栏查看"
        android:textColor="?attr/bcTextSecondary"
        android:textSize="12sp"
        android:visibility="invisible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutTimerButtons" />

    <TextView
        android:id="@+id/textViewQuickSet"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="快速设置"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textViewTimerHint" />

    <!-- 快速设置第一行：30s / 60s / 90s（深蓝细边框 + 极浅蓝底 + 深蓝数字，缩小更灵动） -->
    <LinearLayout
        android:id="@+id/layoutQuickSet"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textViewQuickSet">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonSet30s"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_timer_quickset"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="30s"
            android:textAllCaps="false"
            android:textColor="?attr/bcPrimary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonSet60s"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_timer_quickset"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="60s"
            android:textAllCaps="false"
            android:textColor="?attr/bcPrimary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonSet90s"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_timer_quickset"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="90s"
            android:textAllCaps="false"
            android:textColor="?attr/bcPrimary"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- 快速设置第二行：2min / 3min / 5min（深蓝细边框 + 极浅蓝底 + 深蓝数字，缩小更灵动） -->
    <LinearLayout
        android:id="@+id/layoutQuickSet2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutQuickSet">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonSet2min"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_timer_quickset"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="2min"
            android:textAllCaps="false"
            android:textColor="?attr/bcPrimary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonSet3min"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_timer_quickset"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="3min"
            android:textAllCaps="false"
            android:textColor="?attr/bcPrimary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonSet5min"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_timer_quickset"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="5min"
            android:textAllCaps="false"
            android:textColor="?attr/bcPrimary"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- 省电白名单引导：由代码判断是否显示（已加白名单或用户点过「知道了」则隐藏） -->
    <LinearLayout
        android:id="@+id/layoutBatteryHint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="?attr/bcPrimaryPale"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutQuickSet2">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="训练时手机常常锁屏，系统可能会清理后台进程，导致倒计时中断或收不到提醒。"
            android:textColor="?attr/bcTextPrimary"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonBatteryDismiss"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="40dp"
                android:text="知道了"
                android:textAllCaps="false"
                android:textColor="?attr/bcTextSecondary"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonBatterySettings"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:minHeight="40dp"
                android:text="去设置"
                android:textAllCaps="false"
                android:textColor="?attr/bcPrimary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
