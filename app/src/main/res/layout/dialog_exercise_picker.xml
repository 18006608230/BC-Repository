<?xml version="1.0" encoding="utf-8"?>
<!--
    计划编辑页 · 添加动作选择器（全屏弹窗）
    三级钻取：部位方形卡片 → 子分类卡片 → 动作列表（卡片与主页一致，右侧加号添加）
    顶栏：左上角「完成添加」按钮；二级/三级时右上角出现返回上级箭头
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/bcWindowBg"
    android:orientation="vertical">

    <!-- 顶栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="10dp"
        android:paddingBottom="6dp">

        <!-- 左上角：完成添加 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonPickerDone"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="完成添加"
            android:textColor="?attr/bcPrimary"
            android:textStyle="bold" />

        <!-- 当前层级标题 -->
        <TextView
            android:id="@+id/textViewPickerTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="选择部位"
            android:textColor="?attr/bcTextPrimary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- 返回上级（二级/三级显示） -->
        <ImageButton
            android:id="@+id/buttonPickerBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="返回上级"
            android:src="@drawable/ic_back_arrow"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 内容区：三个层级切换显示 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- 一级：部位方卡（选中天卡标签的部位排前面并高亮） -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerPickerParts"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="6dp"
            android:paddingBottom="16dp"
            android:overScrollMode="never" />

        <!-- 二级：该部位的子分类卡片 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerPickerSubs"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="6dp"
            android:paddingBottom="16dp"
            android:overScrollMode="never"
            android:visibility="gone" />

        <!-- 三级：动作列表（卡片与主页一致，右侧粗加号添加） -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerPickerExercises"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="2dp"
            android:paddingBottom="16dp"
            android:overScrollMode="never"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
