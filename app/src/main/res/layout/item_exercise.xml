<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardBackgroundColor="?attr/bcCardBg"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- 动作配图（GIF 或自定义图片，无配图时隐藏） -->
        <ImageView
            android:id="@+id/imageViewExercise"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_image_thumb"
            android:clipToOutline="true"
            android:contentDescription="动作配图"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- 动作名（卡上的星标单独控制可见与命中，星标不阻挡文字阅读） -->
        <TextView
            android:id="@+id/textViewExerciseName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="动作名称"
            android:textColor="?attr/bcPrimary"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/buttonFavorite"
            app:layout_constraintStart_toEndOf="@+id/imageViewExercise"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- 英文原名副标题（数据集动作有值，精选/自定义留空隐藏） -->
        <TextView
            android:id="@+id/textViewExerciseNameEn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Exercise Name"
            android:textSize="12sp"
            android:textStyle="italic"
            android:textColor="?attr/bcTextSecondary"
            android:visibility="gone"
            app:layout_constraintEnd_toStartOf="@+id/buttonFavorite"
            app:layout_constraintStart_toEndOf="@+id/imageViewExercise"
            app:layout_constraintTop_toBottomOf="@+id/textViewExerciseName" />

        <!-- 快速收藏：右侧小五角星（点击不触发整卡点击） -->
        <ImageButton
            android:id="@+id/buttonFavorite"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="收藏"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_star_outline"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
