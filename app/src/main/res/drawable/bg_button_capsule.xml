<?xml version="1.0" encoding="utf-8"?>
<!--
    悬浮胶囊按钮：深色主题色纯色 + 外圈浅色主题色 + 全圆角胶囊

    与 bg_button_primary 同一套做法（深色纯色 + 浅色外圈），只是圆角做成胶囊。
    按压缩放由 animator 控制。
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">

    <item>
        <layer-list>
            <!-- 外圈：浅色主题色 -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="?attr/bcPrimaryLight" />
                    <corners android:radius="30dp" />
                    <padding
                        android:bottom="2dp"
                        android:left="2dp"
                        android:right="2dp"
                        android:top="2dp" />
                </shape>
            </item>
            <!-- 主体：深色主题色纯色（胶囊：全圆角） -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="?attr/bcPrimaryDark" />
                    <corners android:radius="28dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
