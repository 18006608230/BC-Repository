<?xml version="1.0" encoding="utf-8"?>
<!--
  「使用中」徽章背景：浅色主题色片 + 深主题色描边。
  与统计页 chip 选中态风格一致，文字用 ?attr/bcPrimary（深主题色）而非白色，
  避免浅色模式下白字在浅底上看不清。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="10dp" />
    <solid android:color="?attr/bcPrimaryPale" />
    <stroke
        android:width="1dp"
        android:color="?attr/bcPrimary" />
</shape>
