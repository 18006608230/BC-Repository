<?xml version="1.0" encoding="utf-8"?>
<resources>
<!--
    颜色主题系统（取代暗黑模式）：黑/深蓝/深绿/酒红/日落黄/爱马仕橙/深紫（亮一点、不荧光）。
    Theme.BrawnCatalog 为默认（蓝），其余为覆盖色板的子主题。
    Activity 通过 BaseActivity 在 onCreate 前 setTheme() 应用用户选择。
    布局/drawable 一律用 ?attr/bcXxx 引用，切换主题自动适配字体与背景。
-->
    <!-- 主题：蓝 -->
    <style name="Theme.BrawnCatalog" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/th_blue_primary</item>
        <item name="colorPrimaryVariant">@color/th_blue_primary_dark</item>
        <item name="colorOnPrimary">@color/th_blue_on_primary</item>
        <item name="colorSecondary">@color/th_blue_accent</item>
        <item name="colorSecondaryVariant">@color/th_blue_accent_dark</item>
        <item name="colorOnSecondary">@color/th_blue_on_accent</item>
        <item name="android:textColorPrimary">@color/th_blue_text_primary</item>
        <item name="android:textColorSecondary">@color/th_blue_text_secondary</item>
        <item name="bcPrimary">@color/th_blue_primary</item>
        <item name="bcPrimaryDark">@color/th_blue_primary_dark</item>
        <item name="bcPrimaryLight">@color/th_blue_primary_light</item>
        <item name="bcPrimaryPale">@color/th_blue_primary_pale</item>
        <item name="bcOnPrimary">@color/th_blue_on_primary</item>
        <item name="bcAccent">@color/th_blue_accent</item>
        <item name="bcAccentDark">@color/th_blue_accent_dark</item>
        <item name="bcOnAccent">@color/th_blue_on_accent</item>
        <item name="bcWindowBg">@color/th_blue_window_bg</item>
        <item name="bcCardBg">@color/th_blue_card_bg</item>
        <item name="bcHeaderBg">@color/th_blue_header_bg</item>
        <item name="bcHomePageBg">@color/th_blue_home_page_bg</item>
        <item name="bcTextPrimary">@color/th_blue_text_primary</item>
        <item name="bcTextSecondary">@color/th_blue_text_secondary</item>
        <item name="bcTextDisabled">@color/th_blue_text_disabled</item>
        <item name="bcBorder">@color/th_blue_border</item>
        <item name="bcBorderFocus">@color/th_blue_border_focus</item>
        <item name="bcInputBg">@color/th_blue_input_bg</item>
        <item name="bcInputStroke">@color/th_blue_input_stroke</item>
        <item name="bcGradientStart">@color/th_blue_gradient_start</item>
        <item name="bcGradientEnd">@color/th_blue_gradient_end</item>
        <item name="bcGlow">@color/th_blue_glow</item>
        <item name="bcRipple">@color/th_blue_ripple</item>

        <!-- 状态色（语义色，子主题不覆盖，7 套主题共用同一组值） -->
        <item name="bcStatusOk">@color/bc_status_ok</item>
        <item name="bcStatusWarn">@color/bc_status_warn</item>
        <item name="bcStatusLow">@color/bc_status_low</item>

        <!-- ===== 文字/表面前景色兜底 =====
             基底主题 Theme.MaterialComponents.NoActionBar 属于 Material "暗色"主题，
             凡未被显式覆盖的 Material 属性都会继承暗色默认值（白色前景/深色表面），
             表现为浅色卡片上的「白字看不清」。这里在基础主题统一声明一次，
             7 套子主题各自覆盖 bc* 后会自动跟随。 -->
        <item name="android:textColor">?attr/bcTextPrimary</item>
        <item name="android:textColorHint">?attr/bcInputStroke</item>
        <item name="colorSurface">?attr/bcCardBg</item>
        <item name="colorSurfaceVariant">?attr/bcCardBg</item>
        <item name="colorOnSurface">?attr/bcTextPrimary</item>
        <item name="colorOnSurfaceVariant">?attr/bcTextSecondary</item>
        <item name="colorOnBackground">?attr/bcTextPrimary</item>
        <item name="android:windowBackground">@color/th_blue_window_bg</item>
        <item name="android:statusBarColor">@color/th_blue_header_bg</item>
        <item name="android:navigationBarColor">@color/th_blue_window_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="materialCardViewStyle">@style/Widget.BrawnCatalog.Card</item>
        <item name="materialButtonStyle">@style/Widget.BrawnCatalog.Button.Primary</item>
        <item name="textInputStyle">@style/Widget.BrawnCatalog.TextInputLayout</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.BrawnCatalog.Dialog.Alert</item>
        <item name="android:alertDialogTheme">@style/ThemeOverlay.BrawnCatalog.Dialog.Alert</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.BrawnCatalog.Dialog.Alert</item>
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_right</item>
        <item name="android:activityOpenExitAnimation">@anim/slide_out_left</item>
        <item name="android:activityCloseEnterAnimation">@anim/slide_in_left</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_right</item>
    </style>
