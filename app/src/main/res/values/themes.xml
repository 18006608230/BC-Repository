        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowElevation">0dp</item>
        <item name="android:backgroundDimAmount">0.4</item>
        <item name="materialCardViewStyle">@style/Widget.BrawnCatalog.Card</item>
        <item name="materialButtonStyle">@style/Widget.BrawnCatalog.Button.Primary</item>
        <item name="textInputStyle">@style/Widget.BrawnCatalog.TextInputLayout</item>
        <!-- 父主题 Theme.MaterialComponents.Dialog 是 Material 暗色主题，
             不显式声明时卡片上的文字会继承为白色，在浅色卡片背景上完全看不见。
             这里把前景色/主题色显式绑定到 bc* 主题属性。 -->
        <item name="android:textColor">?attr/bcTextPrimary</item>
        <item name="android:textColorPrimary">?attr/bcTextPrimary</item>
        <item name="android:textColorSecondary">?attr/bcTextSecondary</item>
        <item name="android:textColorHint">?attr/bcInputStroke</item>
        <item name="colorPrimary">?attr/bcPrimary</item>
        <item name="colorPrimaryVariant">?attr/bcPrimaryDark</item>
        <item name="colorOnPrimary">?attr/bcOnPrimary</item>
        <item name="colorSurface">?attr/bcCardBg</item>
        <item name="colorOnSurface">?attr/bcTextPrimary</item>
        <item name="colorOnSurfaceVariant">?attr/bcTextSecondary</item>
        <item name="colorOnBackground">?attr/bcTextPrimary</item>
    </style>

    <style name="Theme.BrawnCatalog.PlanDetail" parent="Theme.BrawnCatalog">
        <item name="android:statusBarColor">?attr/bcHeaderBg</item>
    </style>

    <style name="ThemeOverlay.BrawnCatalog.Dialog.Alert" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="android:windowBackground">@drawable/bg_dialog_alert</item>
        <item name="android:windowMinWidthMajor">85%</item>
        <item name="android:windowMinWidthMinor">85%</item>
        <item name="android:backgroundDimAmount">0.4</item>
        <item name="colorPrimary">?attr/bcPrimary</item>
        <item name="colorPrimaryVariant">?attr/bcPrimaryDark</item>
        <item name="colorOnPrimary">?attr/bcOnPrimary</item>
        <item name="colorAccent">?attr/bcPrimary</item>
        <item name="colorControlActivated">?attr/bcPrimary</item>
        <item name="android:textColorPrimary">?attr/bcTextPrimary</item>
        <item name="android:textColorSecondary">?attr/bcTextSecondary</item>
        <!-- 标题/正文/列表项（如长按动作菜单的「编辑动作 / 删除动作 / 取消」）
             统一为深色文字，避免继承到暗色主题的白色 -->
        <item name="android:textColor">?attr/bcTextPrimary</item>
        <item name="android:textColorAlertDialogListItem">?attr/bcTextPrimary</item>
        <item name="materialButtonStyle">@style/Widget.BrawnCatalog.Button.Primary</item>
    </style>

    <!-- ===== 卡片：圆角 + 阴影，底色随主题 ===== -->
    <style name="Widget.BrawnCatalog.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">?attr/bcCardBg</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">4dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- ===== 主按钮：主题渐变 + 圆角 ===== -->
    <style name="Widget.BrawnCatalog.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textColor">?attr/bcOnPrimary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:stateListAnimator">@animator/button_press_scale</item>
        <item name="rippleColor">#33FFFFFF</item>
        <item name="cornerRadius">14dp</item>
        <item name="backgroundTint">@null</item>
    </style>

    <!-- ===== 输入框：主题底色 + 主题描边 ===== -->
    <style name="Widget.BrawnCatalog.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">?attr/bcInputBg</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1dp</item>
        <item name="boxStrokeColor">?attr/bcInputStroke</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="hintTextColor">?attr/bcInputStroke</item>
    </style>

    <!-- ===== Tab：主题色指示器与选中文字 ===== -->
    <style name="Widget.BrawnCatalog.TabLayout" parent="Widget.MaterialComponents.TabLayout">
        <item name="tabIndicatorColor">?attr/bcPrimary</item>
        <item name="tabIndicatorHeight">2dp</item>
        <item name="tabSelectedTextColor">?attr/bcPrimary</item>
        <item name="tabTextColor">?attr/bcTextPrimary</item>
        <item name="tabRippleColor">?attr/bcRipple</item>
        <item name="tabIndicatorFullWidth">false</item>
    </style>

    <!-- ===== Chip（统计页时间范围）：完全控制视觉，去掉 Material Chip.Choice 内部的
         "colorOnSurface" 黑色叠加导致未选中态呈"黑色一坨"问题；选中 = 浅色片 + 深主题色边框
         + 深主题色文字，未选中 = 透明 + 浅边框 + 普通文字 ===== -->
    <style name="Widget.BrawnCatalog.Chip.Range" parent="Widget.MaterialComponents.Chip.Action">
        <item name="chipBackgroundColor">@color/chip_state_bg</item>
        <item name="chipStrokeColor">@color/chip_state_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipSurfaceColor">@android:color/transparent</item>
        <item name="chipIconTint">@android:color/transparent</item>
        <item name="checkedIconTint">@android:color/transparent</item>
        <item name="checkedIconVisible">false</item>
        <item name="android:textColor">@color/chip_state_text</item>
        <item name="rippleColor">@color/chip_state_ripple</item>
        <item name="closeIconVisible">false</item>
        <item name="chipMinHeight">36dp</item>
        <item name="ensureMinTouchTargetSize">false</item>
    </style>
</resources>