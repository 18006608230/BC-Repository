<?xml version="1.0" encoding="utf-8"?>
<!-- 按钮按压：按下缩小到 0.96，松手弹簧回弹（overshoot） -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <set>
            <objectAnimator
                android:propertyName="scaleX"
                android:duration="90"
                android:valueTo="0.96"
                android:valueType="floatType" />
            <objectAnimator
                android:propertyName="scaleY"
                android:duration="90"
                android:valueTo="0.96"
                android:valueType="floatType" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator
                android:propertyName="scaleX"
                android:duration="240"
                android:valueTo="1.0"
                android:valueType="floatType"
                android:interpolator="@interpolator/spring_overshoot" />
            <objectAnimator
                android:propertyName="scaleY"
                android:duration="240"
                android:valueTo="1.0"
                android:valueType="floatType"
                android:interpolator="@interpolator/spring_overshoot" />
        </set>
    </item>
</selector>
